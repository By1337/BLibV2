<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.by1337.core</groupId>
    <artifactId>BLibV2</artifactId>
    <version>1.10.6</version>

    <properties>
        <java.version>16</java.version>
        <bpatch.version>1.0.0</bpatch.version>
        <java.source>16</java.source>
        <java.target>16</java.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <distributionManagement>
        <repository>
            <id>bdev-repo</id>
            <name>releases</name>
            <url>https://repo.by1337.space/releases</url>
        </repository>
    </distributionManagement>

    <build>
        <defaultGoal>clean install</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.source}</source>
                    <target>${java.target}</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>dev.by1337.bpatch</groupId>
                <artifactId>bpatch-maven-plugin</artifactId>
                <version>${bpatch.version}</version>
                <executions>
                    <execution>
                        <id>pack-runtime-bridges</id>
                        <goals>
                            <goal>pack</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jars>
                        <jar>
                            <artifact>org.by1337.blib:BLib:1.9.10</artifact>
                            <output>bridges/BLib-bridge-1.9.10.jar</output>
                            <compression>STORED</compression>
                        </jar>
                    </jars>
                    <patchSets>
                        <patchSet>
                            <output>bridges/nms.zip</output>
                            <compression>STORED</compression>
                            <mode>CHAIN</mode>
                            <excludeMetaInf>true</excludeMetaInf>
                            <versions>
                                <version>
                                    <id>1.16.5</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.16.5</artifact>
                                </version>
                                <version>
                                    <id>1.17.1</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.17.1</artifact>
                                </version>
                                <version>
                                    <id>1.18.2</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.18.2</artifact>
                                </version>
                                <version>
                                    <id>1.19.4</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.19.4</artifact>
                                </version>
                                <version>
                                    <id>1.20.1</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.20.1</artifact>
                                </version>
                                <version>
                                    <id>1.20.2</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.20.2</artifact>
                                </version>
                                <version>
                                    <id>1.20.4</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.20.4</artifact>
                                </version>
                                <version>
                                    <id>1.20.6</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.20.6</artifact>
                                </version>
                                <version>
                                    <id>1.21</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.21</artifact>
                                </version>
                                <version>
                                    <id>1.21.3</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.21.3</artifact>
                                </version>
                                <version>
                                    <id>1.21.4</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.21.4</artifact>
                                </version>
                                <version>
                                    <id>1.21.5</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.5+1.21.5</artifact>
                                </version>
                                <version>
                                    <id>1.21.6</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.6+1.21.6</artifact>
                                </version>
                                <version>
                                    <id>1.21.7</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.6+1.21.7</artifact>
                                </version>
                                <version>
                                    <id>1.21.8</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.6+1.21.8</artifact>
                                </version>
                                <version>
                                    <id>1.21.9</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.6+1.21.9</artifact>
                                </version>
                                <version>
                                    <id>1.21.10</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.6+1.21.10</artifact>
                                </version>
                                <version>
                                    <id>1.21.11</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.6+1.21.11</artifact>
                                </version>
                                <version>
                                    <id>26.1.2</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.6+26.1.2</artifact>
                                </version>
                                <version>
                                    <id>26.2</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.6+26.2</artifact>
                                </version>
                                <version>
                                    <id>26.3</id>
                                    <artifact>dev.by1337.core.nms:BLibNms:1.6+26.3</artifact>
                                </version>
                            </versions>
                        </patchSet>
                    </patchSets>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <exclude>dev.by1337.core.nms:*</exclude>
                                    <exclude>org.ow2.asm:*</exclude>
                                    <exclude>com.github.ben-manes.caffeine:*</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <paperweight-mappings-namespace>mojang</paperweight-mappings-namespace>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>minecraft-libraries</id>
            <name>Minecraft Libraries</name>
            <url>https://libraries.minecraft.net</url>
        </repository>
        <repository>
            <id>bdev-repo</id>
            <name>releases</name>
            <url>https://repo.by1337.space/releases</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>bdev-repo</id>
            <name>releases</name>
            <url>https://repo.by1337.space/releases</url>
        </pluginRepository>
    </pluginRepositories>


    <dependencies>
        <dependency>
            <groupId>dev.by1337.bpatch</groupId>
            <artifactId>bpatch-runtime</artifactId>
            <version>${bpatch.version}</version>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.25.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-gson</artifactId>
            <version>4.25.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.destroystokyo.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.16.5-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.plc</groupId>
            <artifactId>BPlaceholder</artifactId>
            <version>1.3</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.yaml</groupId>
            <artifactId>byaml-bukkit</artifactId>
            <version>1.6.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.cmd</groupId>
            <artifactId>BCmd</artifactId>
            <version>1.4</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.particle</groupId>
            <artifactId>render-bukkit</artifactId>
            <version>2.2</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.particle</groupId>
            <artifactId>flow</artifactId>
            <version>2.2</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.item</groupId>
            <artifactId>ConfigurableItems</artifactId>
            <version>1.8.3</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.edsl</groupId>
            <artifactId>EventDSL</artifactId>
            <version>1.8.4</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.sync</groupId>
            <artifactId>bsync-k2v</artifactId>
            <version>1.4</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion>
                    <groupId>dev.by1337.sync</groupId>
                    <artifactId>bsync-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>dev.by1337.sync</groupId>
                    <artifactId>bsync-bukkit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.2.4</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.destroystokyo.paper</groupId>
            <artifactId>paper-mojangapi</artifactId>
            <version>1.16.5-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>brigadier</artifactId>
            <scope>provided</scope>
            <version>1.0.18</version>
        </dependency>

        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.9.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <version>8.2.2</version> <!-- 1.16.5 version-->
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec</artifactId>
            <version>4.1.115.Final</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.errorprone</groupId>
            <artifactId>error_prone_annotations</artifactId>
            <scope>provided</scope>
            <version>2.23.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>31.1-jre</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
